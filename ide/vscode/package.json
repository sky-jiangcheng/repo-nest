{
  "name": "repotory-vscode",
  "displayName": "Repotory",
  "publisher": "sky-jiangcheng",
  "version": "2.4.0",
  "description": "Repotory inside your IDE: load session context, write session handoffs and search your local knowledge base from the command palette, status bar and sidebar. One VSIX covers VS Code, Cursor and Windsurf.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repotory.loadContext",
        "title": "Repotory: Load Session Context"
      },
      {
        "command": "repotory.handoff",
        "title": "Repotory: Write Session Handoff"
      },
      {
        "command": "repotory.search",
        "title": "Repotory: Search Knowledge"
      },
      {
        "command": "repotory.registerMcp",
        "title": "Repotory: Register MCP Server (repotory-init)"
      }
    ],
    "keybindings": [
      {
        "command": "repotory.loadContext",
        "key": "ctrl+alt+r c",
        "mac": "ctrl+cmd+r c"
      },
      {
        "command": "repotory.handoff",
        "key": "ctrl+alt+r h",
        "mac": "ctrl+cmd+r h"
      },
      {
        "command": "repotory.search",
        "key": "ctrl+alt+r s",
        "mac": "ctrl+cmd+r s"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "repotory.search",
          "when": "view == repotory.notesSearch",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Repotory",
      "properties": {
        "repotory.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18765",
          "description": "Repotory headless service URL (repotory server)."
        }
      }
    },
    "views": {
      "repotory-explorer": [
        {
          "id": "repotory.notesSearch",
          "name": "Knowledge Search"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repotory-explorer",
          "title": "Repotory",
          "icon": "media/repotory.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/sync-init.mjs",
    "sync-init": "node scripts/sync-init.mjs",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sky-jiangcheng/repotory.git"
  },
  "homepage": "https://github.com/sky-jiangcheng/repotory/tree/master/ide/vscode",
  "bugs": {
    "url": "https://github.com/sky-jiangcheng/repotory/issues"
  },
  "keywords": [
    "repotory",
    "knowledge base",
    "session context",
    "handoff",
    "notes",
    "search",
    "claude",
    "cursor",
    "windsurf",
    "mcp"
  ]
}
